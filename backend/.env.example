# Copy this file to .env and fill in the values. Never commit .env.

# LLM (needed from Stage 3)
GENAI_PLATFORM_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
VISION_DEPLOYMENT_NAME=

# Storage
DATA_DIR=../data

# Upload limits
MAX_UPLOAD_MB=25
MAX_UPLOAD_ROWS=200000

# Query execution limits
QUERY_TIMEOUT_SECONDS=15
QUERY_MAX_ROWS=1000
# LLM attempts per question (the first try plus corrections after a failed check)
SQL_MAX_ATTEMPTS=3
# Ask a clarifying question before answering a vague one ("best-performing product").
AMBIGUITY_CHECK=true
# Run that check at the same time as writing the SQL, so a clear question waits for the slower of the two
# instead of both (about a quarter faster in our measurements). If the question turns out to be vague, the
# SQL that was written is thrown away, so a few model calls are wasted. Set to false to avoid that.
AMBIGUITY_PARALLEL=true
# Columns queries may never read, e.g. customers.email,payments.*
BLOCKED_COLUMNS=

# External databases (PostgreSQL)
# Hosts users may connect to: names, *.example.com wildcards, IPs or CIDR ranges. '*' allows any host.
# The default allows this machine only, so the server cannot be used to probe other networks.
ALLOWED_DB_HOSTS=localhost,127.0.0.1,::1
# Superuser accounts can switch off the read-only protections, so they are refused unless you opt in.
ALLOW_SUPERUSER_CONNECTIONS=false
# Encrypts stored database passwords (a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
# If empty, a key is generated into DATA_DIR/credentials.key. Set this from a secrets manager when sharing the server.
CREDENTIALS_KEY=
DB_CONNECT_TIMEOUT_SECONDS=10

# Query history
# Questions, SQL and summaries are always kept. Result rows are sensitive, so they are kept only if
# you set this above 0 (then at most this many rows per answer are saved, so past answers can be shown again).
HISTORY_RETAIN_ROWS=0
# History older than this many days is deleted automatically. 0 keeps it forever.
HISTORY_RETENTION_DAYS=90

# Accounts and limits
# accounts: people register and log in, and each sees only their own data (the default).
# none: no login. A browser names its own workspace, so anyone who can reach the server can read anyone's
#       data. Use it only for one person on their own machine.
AUTH_MODE=accounts
# Let new people create an account. Turn off once everyone who needs one has one.
ALLOW_REGISTRATION=true
# A login lasts this many days since it was last used.
SESSION_DAYS=7
# Wrong passwords before a username (or one network address) is locked out, and for how long.
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCKOUT_MINUTES=15
REGISTER_PER_HOUR_PER_IP=10
# Requests per minute per person. Questions to the AI model cost money and time, so they have their own,
# lower limit. 0 turns a limit off. A question counts once, and the written summary of its answer counts once
# more, so 20 allows about 10 answered questions a minute. Counts are kept in memory, so run one server
# process for exact limits.
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_LLM_PER_MINUTE=20
# Testing or saving a database connection reveals whether something is listening at a host, so it has its own,
# much lower limit (shared by both, and refused hosts count too).
RATE_LIMIT_DB_PROBE_PER_MINUTE=10
# External databases one person may keep connected (0 = no limit).
MAX_CONNECTIONS_PER_WORKSPACE=10

# CORS (frontend dev server)
CORS_ORIGINS=http://localhost:5173
